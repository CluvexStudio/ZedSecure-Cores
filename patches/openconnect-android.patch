+static int open_webview_cb(struct openconnect_info *vpninfo, const char *uri, void *privdata)
+{
+	struct libctx *ctx = privdata;
+	jstring juri;
+	int ret = -1;
+	jmethodID mid;
+
+	(void)vpninfo;
+
+	if ((*ctx->jenv)->PushLocalFrame(ctx->jenv, 256) < 0)
+		return -1;
+
+	juri = dup_to_jstring(ctx->jenv, uri);
+	if (!juri)
+		goto out;
+
+	mid = get_obj_mid(ctx, ctx->jobj, "onOpenWebview", "(Ljava/lang/String;)I");
+	if (mid)
+		ret = (*ctx->jenv)->CallIntMethod(ctx->jenv, ctx->jobj, mid, juri);
+
+out:
+	(*ctx->jenv)->PopLocalFrame(ctx->jenv, NULL);
+	return ret;
+}
+
+static const char **jstr_array_dup(JNIEnv *jenv, jobjectArray jarr)
+{
+	jsize n, i;
+	const char **out;
+
+	if (!jarr)
+		return NULL;
+	n = (*jenv)->GetArrayLength(jenv, jarr);
+	out = calloc((size_t)n + 1, sizeof(*out));
+	if (!out)
+		return NULL;
+	for (i = 0; i < n; i++) {
+		jstring js = (*jenv)->GetObjectArrayElement(jenv, jarr, i);
+		const char *cs = js ? (*jenv)->GetStringUTFChars(jenv, js, NULL) : NULL;
+		out[i] = strdup(cs ? cs : "");
+		if (js) {
+			if (cs)
+				(*jenv)->ReleaseStringUTFChars(jenv, js, cs);
+			(*jenv)->DeleteLocalRef(jenv, js);
+		}
+	}
+	out[n] = NULL;
+	return out;
+}
+
+static void jstr_array_free(const char **arr)
+{
+	int i;
+
+	if (!arr)
+		return;
+	for (i = 0; arr[i]; i++)
+		free((void *)arr[i]);
+	free((void *)arr);
+}
+
+JNIEXPORT jint JNICALL Java_org_infradead_libopenconnect_LibOpenConnect_webviewLoadChanged(
+	JNIEnv *jenv, jobject jobj, jstring juri, jobjectArray jcookies, jobjectArray jheaders)
+{
+	struct libctx *ctx = getctx(jenv, jobj);
+	struct oc_webview_result result;
+	const char *uri = NULL;
+	const char **cookies, **headers;
+	int ret;
+
+	if (!ctx)
+		return -1;
+	if (get_cstring(ctx->jenv, juri, &uri))
+		return -1;
+
+	cookies = jstr_array_dup(ctx->jenv, jcookies);
+	headers = jstr_array_dup(ctx->jenv, jheaders);
+
+	memset(&result, 0, sizeof(result));
+	result.uri = uri;
+	result.cookies = cookies;
+	result.headers = headers;
+
+	ret = openconnect_webview_load_changed(ctx->vpninfo, &result);
+
+	jstr_array_free(cookies);
+	jstr_array_free(headers);
+	release_cstring(ctx->jenv, juri, uri);
+	return ret;
+}
